{
  "version": "0.1.0",
  "id": "arrivieren-hauswand",
  "title": "Arrivieren Hauswand-Zufall",
  "units": "cm",
  "grid": {
    "planGridCm": 48,
    "masonryStepCm": 8,
    "wallHeightCm": 448,
    "wallDepthCm": 32,
    "defaultWindow": { "widthCm": 96, "heightCm": 192, "sillYCm": 128 },
    "endPierCm": 96,
    "interPierCm": 96,
    "widthFormula": "n * (windowWidth + 96) + 96 for endMargin=96"
  },
  "constraints": {
    "storeys": { "min": 2, "max": 5, "note": "Zufall: 2–5 Geschosse, nie 1; Schwerpunkt 3–4 (weights.storeys)" },
    "axes": { "min": 3, "softMax": 7, "hardMax": 15, "note": "Soft: 3–7 Achsen ≈ 3–7×96er-Fenster; Hard-Max nur explizit" },
    "driveway": { "maxPerFacade": 1 },
    "bay": {
      "neverOnGroundFloor": true,
      "neverOnTopStorey": true,
      "singleTypePerHouse": true,
      "mustStackSameAxes": true,
      "minStoreys": 4,
      "minAxes": 4,
      "allowedShapes": ["rect", "angled45"]
    },
    "upperFloors": {
      "sameWindowTypePerAxis": true,
      "openingsMustAlignVertically": true
    },
    "groundFloor": {
      "mayDifferFromUpper": true,
      "mustShareTotalWidth": true,
      "groupsSnapToWholeAxes": true
    },
    "validity": [
      "sameTotalWidthAllStoreys",
      "ogOpeningsOnAxisGrid",
      "egGroupsOnWholeAxes",
      "bayColumnContinuous"
    ]
  },
  "enums": {
    "egType": ["entrance", "driveway", "shopWindow", "shopfrontGroup", "residentialWindows"],
    "bayShape": ["none", "rect", "angled45", "round"]
  },
  "weights": {
    "storeys": { "2": 0.18, "3": 0.32, "4": 0.30, "5": 0.20 },
    "axes": { "3": 0.12, "4": 0.22, "5": 0.26, "6": 0.24, "7": 0.16 },
    "egType": {
      "entrance": 0.28,
      "driveway": 0.12,
      "shopWindow": 0.18,
      "shopfrontGroup": 0.22,
      "residentialWindows": 0.20
    },
    "bayPresence": {
      "none": 0.88,
      "present": 0.12,
      "gate": { "minStoreys": 4, "minAxes": 4 }
    },
    "bayShapeWhenPresent": { "rect": 0.55, "angled45": 0.45 },
    "bayAxisSpan": { "1": 0.5, "2": 0.5 },
    "bayFrontWidthCm": { "288": 0.55, "384": 0.45 },
    "bayHorizontalPlacement": { "centerish": 0.55, "leftThird": 0.225, "rightThird": 0.225 }
  },
  "derived": {
    "widthCm": "axes * 144 + 48",
    "bayFloors": "storeys >= 4 ? floors 1..(storeys-2) inclusive (0=EG excluded, top excluded) : none"
  },
  "feedbackSchema": {
    "verdict": ["ok", "wrong"],
    "brokenRules": [
      "storeys",
      "axes",
      "width",
      "egType",
      "egAlignment",
      "ogWindows",
      "bayPlacement",
      "bayStacking",
      "proportions",
      "other"
    ],
    "note": "string",
    "suggestedWeightTweaks": "optional free text"
  }
}
